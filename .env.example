NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=your-web-push-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=your-web-push-vapid-private-key
WEB_PUSH_VAPID_SUBJECT=mailto:hello@clarionot.com
PUSH_CRON_SECRET=your-random-cron-secret
SITE_URL=https://your-production-domain.com
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
# Stripe: Pro fiyatı ve checkout bu değişkenlere bağlı (/api/billing/price,
# /api/billing/checkout). Eksik olursa fiyat "Fiyat alınamadı" hatası verir.
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_LOOKUP_KEY_PRO_MONTHLY=your-stripe-price-lookup-key
OPENAI_API_KEY=your-openai-api-key
# Copy these from Supabase Dashboard > Project Settings > API.
# Restart the Next.js dev server after changing .env.local.
